# Copy to .env (make env) and fill in. .env is git-ignored; never commit real keys.

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please     # min 8 characters
NEO4J_URI=bolt://localhost:7687     # containers use bolt://neo4j:7687

# --- Jupyter (empty = no token; ports are bound to 127.0.0.1 only) ---
JUPYTER_TOKEN=

# --- HDFS / Spark (in-network addresses) ---
HDFS_URL=hdfs://namenode:9000
SPARK_MASTER_URL=spark://spark-master:7077

# --- Crawler (Phase 1) ---
CRAWLER_CONTACT=                     # email or URL added to the User-Agent (Wikimedia UA policy)

# --- LLM: Google Gemini free tier via its OpenAI-compatible endpoint (Phase 2+) ---
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash-lite
ANSWER_MODEL=gemini-3.5-flash-lite   # GraphRAG answers (Phase 4+). Decided 2026-10-29: 500 requests/day
                                     #   (gemini-3.5-flash allows only 20/day on the free tier)
JUDGE_MODEL=openai/gpt-oss-120b      # Phase 6 answer judge, on Groq (GROQ_API_KEY): another model family
# Gold pre-fill drafts (RQ1): Groq free tier, OpenAI-compatible. Must differ from EXTRACTION_MODEL.
GROQ_API_KEY=
PREFILL_MODEL=openai/gpt-oss-120b      # Groq lists no Llama 70B any more; gpt-oss-120b is the closest open-weight class
PREFILL_FALLBACK_MODEL=qwen/qwen3.8-27b # used only for a chunk where PREFILL_MODEL keeps failing
PREFILL_BASE_URL=https://api.groq.com/openai/v1
PREFILL_MIN_INTERVAL_S=4
LLM_MIN_INTERVAL_S=4.5               # min seconds between request starts (free-tier RPM)
LLM_CONCURRENCY=3                    # parallel requests
LLM_MAX_RETRIES=6
LLM_PRICE_IN_PER_M=0                 # USD per 1M tokens: 0 on the free tier; set list
LLM_PRICE_OUT_PER_M=0                #   prices to estimate what a paid run would cost (RQ4)

# --- Embeddings (fastembed / ONNX, no torch) ---
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Logging ---
LLM_CALL_LOG=logs/llm_calls.jsonl     # inside containers: /app/logs/llm_calls.jsonl

# --- Phase 7 API / UI (make api-keys fills these in .env with random keys) ---
API_KEYS_ADMIN=                       # comma-separated, >= 16 chars each: everything incl. /metrics
API_KEYS_VIEWER=                      # comma-separated: /ask and read-only endpoints
UI_API_KEY=                           # key the Streamlit UI uses (a viewer key)
