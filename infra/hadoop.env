# Hadoop settings for the bde2020 images. Each VAR becomes a property:
# CORE_CONF_fs_defaultFS -> core-site.xml fs.defaultFS ("___" = "-", "__" = "_", "_" = ".")
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
# Replication (2 full / 1 lite) is set per stack in docker-compose*.yml, not here.
# Single-user dev cluster: Spark executors run as "spark", Jupyter as "jovyan".
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
